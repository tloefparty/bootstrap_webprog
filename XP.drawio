        <mxCell id="SiKDRpSCKRkWt_P-Qd1S-1" parent="1" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=13;strokeWidth=2;rounded=1;arcSize=50;fillColor=#34327A;fontColor=#FFFFFF;strokeColor=#34327A;fontStyle=1;" value="START: XP Quest Board (USERDES)" vertex="1">
          <mxGeometry height="50" width="360" x="300" y="20" as="geometry" />
        </mxCell>
        <mxCell id="SiKDRpSCKRkWt_P-Qd1S-2" parent="1" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=13;strokeWidth=2;rounded=1;arcSize=12;fillColor=#E4F0FC;strokeColor=#3D8FD6;fontColor=#211F3D;align=left;spacingLeft=10;" value="&lt;b&gt;USER&lt;/b&gt;&lt;br&gt;Students and young adults in the Philippines with about 6 free hours a week who want to earn, volunteer or upskill" vertex="1">
          <mxGeometry height="80" width="360" x="300" y="110" as="geometry" />
        </mxCell>
        <mxCell id="SiKDRpSCKRkWt_P-Qd1S-3" parent="1" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=13;strokeWidth=2;rounded=1;arcSize=12;fillColor=#E4F0FC;strokeColor=#3D8FD6;fontColor=#211F3D;align=left;spacingLeft=10;" value="&lt;b&gt;NEEDS &amp;amp; PROBLEMS&lt;/b&gt;&lt;br&gt;• Opportunities scattered across posts and chats&lt;br&gt;• Hard to tell paid / free / fee-based apart&lt;br&gt;• Little time: must filter by hours and location" vertex="1">
          <mxGeometry height="100" width="360" x="300" y="230" as="geometry" />
        </mxCell>
        <mxCell id="SiKDRpSCKRkWt_P-Qd1S-4" parent="1" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=13;strokeWidth=2;rounded=1;arcSize=12;fillColor=#E1F5EE;strokeColor=#2FAE8B;fontColor=#211F3D;align=left;spacingLeft=10;" value="&lt;b&gt;GOALS&lt;/b&gt;&lt;br&gt;Find a fitting quest in under a minute, know cost or pay up front, feel rewarded for finishing" vertex="1">
          <mxGeometry height="80" width="360" x="300" y="370" as="geometry" />
        </mxCell>
        <mxCell id="SiKDRpSCKRkWt_P-Qd1S-5" parent="1" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=13;strokeWidth=2;rounded=1;arcSize=12;fillColor=#E1F5EE;strokeColor=#2FAE8B;fontColor=#211F3D;align=left;spacingLeft=10;" value="&lt;b&gt;DESIGN DECISIONS&lt;/b&gt;&lt;br&gt;Translate needs and goals into the wireframe" vertex="1">
          <mxGeometry height="64" width="360" x="300" y="490" as="geometry" />
        </mxCell>
        <mxCell id="SiKDRpSCKRkWt_P-Qd1S-6" parent="1" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=13;strokeWidth=2;shape=note;size=14;fillColor=#FFF7E0;strokeColor=#F5B942;fontColor=#211F3D;align=left;spacingLeft=8;verticalAlign=top;" value="&lt;b&gt;Decisions&lt;/b&gt;&lt;br&gt;1. Hero + profile card shows progress&lt;br&gt;2. Color-coded tiers (blue paid, green free, red premium)&lt;br&gt;3. Filters above results, instant update&lt;br&gt;4. Confirm modal + restore list for undo&lt;br&gt;5. Bold first two words of titles (Clarence)&lt;br&gt;6. Restore-deleted on main board (Nethan)&lt;br&gt;7. Dark mode" vertex="1">
          <mxGeometry height="170" width="300" x="710" y="440" as="geometry" />
        </mxCell>
        <mxCell id="SiKDRpSCKRkWt_P-Qd1S-7" parent="1" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=13;strokeWidth=2;rounded=1;arcSize=12;fillColor=#E7EAF7;strokeColor=#4A4E9E;fontColor=#211F3D;align=left;spacingLeft=10;" value="&lt;b&gt;SITEMAP&lt;/b&gt;&lt;br&gt;Home (Hero + Profile) → How it works → Quest Board → Add Quest → Footer" vertex="1">
          <mxGeometry height="70" width="360" x="300" y="594" as="geometry" />
        </mxCell>
        <mxCell id="SiKDRpSCKRkWt_P-Qd1S-8" parent="1" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=13;strokeWidth=2;rounded=1;arcSize=12;fillColor=#E7EAF7;strokeColor=#4A4E9E;fontColor=#211F3D;align=left;spacingLeft=10;" value="&lt;b&gt;BUILD WITH BOOTSTRAP 5&lt;/b&gt;&lt;br&gt;12 components + utilities, custom.css for brand colors" vertex="1">
          <mxGeometry height="70" width="360" x="300" y="704" as="geometry" />
        </mxCell>
        <mxCell id="SiKDRpSCKRkWt_P-Qd1S-9" parent="1" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=13;strokeWidth=2;rounded=1;arcSize=12;fillColor=#FFF7E0;strokeColor=#F5B942;fontColor=#211F3D;align=left;spacingLeft=10;" value="&lt;b&gt;EVALUATE&lt;/b&gt;&lt;br&gt;Test with 3 to 5 classmates: find a free quest under 3 hrs, post a custom quest, delete and restore one. Record time and errors" vertex="1">
